<!DOCTYPE html>
<html>
<head>
  <title>AI Chatbot</title>
  <style>
    body { font-family: Arial; background:#f5f5f5; }
    #chat { width:300px; height:400px; background:white; padding:10px; overflow:auto; }
    input { width:240px; }
  </style>
</head>
<body>

<h3>AI Bot Demo</h3>

<div id="chat"></div>
<input id="msg" placeholder="اكتب رسالة..." />
<button onclick="send()">إرسال</button>

<script>
async function send() {
    let msg = document.getElementById("msg").value;
    let chat = document.getElementById("chat");

    chat.innerHTML += "<p><b>أنت:</b> " + msg + "</p>";

    let res = await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer YOUR_API_KEY"
        },
        body: JSON.stringify({
            model: "gpt-4o-mini",
            messages: [
                {role: "system", content: "أنت مساعد خدمة عملاء لبيزنس وترد باحتراف."},
                {role: "user", content: msg}
            ]
        })
    });

    let data = await res.json();
    let reply = data.choices[0].message.content;

    chat.innerHTML += "<p><b>AI:</b> " + reply + "</p>";
}
</script>

</body>
</html>
